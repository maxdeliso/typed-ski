data EmitRes =
  | MkEmitRes Bin (List (List U8)) (List U8)

data BindGlobalArgsRes =
  | MkBindGlobalArgsRes (List ((List U8), (List U8))) Bin (List (List U8)) (List AnfExpr)

data ClosedGlobals =
  | MkClosedGlobals (BridgeAvl U8) (List (List U8))

poly rec lookupEnv =
  \env : List ((List U8), (List U8)) =>
    \name : List U8 =>
      matchList
        [((List U8), (List U8))]
        [Maybe (List U8)]
        env
        (None [List U8])
        (
          \h : ((List U8), (List U8)) =>
            \t : List ((List U8), (List U8)) =>
              if [Maybe (List U8)] (eqListU8 (fst [List U8] [List U8] h) name)
                (\u : U8 => Some [List U8] (snd [List U8] [List U8] h))
                (\u : U8 => lookupEnv t name)
        )

poly atomOperand =
  \env : List ((List U8), (List U8)) =>
    \e : AnfExpr =>
      match e [Result (List U8) (List U8)] {
        | AE_Var n =>
          match (lookupEnv env n) [Result (List U8) (List U8)] {
            | None =>
              Err [List U8] [List U8] (append [U8] "Unbound variable: " n)
            | Some op => Ok [List U8] [List U8] op
          }
        | AE_Native t =>
          match t [Result (List U8) (List U8)] {
            | T_Byte b => Ok [List U8] [List U8] (u8ToDigits b)
            | T_S =>
              Err [List U8] [List U8] "Unsupported atomic expression"
            | T_K =>
              Err [List U8] [List U8] "Unsupported atomic expression"
            | T_I =>
              Err [List U8] [List U8] "Unsupported atomic expression"
            | T_B =>
              Err [List U8] [List U8] "Unsupported atomic expression"
            | T_C =>
              Err [List U8] [List U8] "Unsupported atomic expression"
            | T_SPrime =>
              Err [List U8] [List U8] "Unsupported atomic expression"
            | T_BPrime =>
              Err [List U8] [List U8] "Unsupported atomic expression"
            | T_CPrime =>
              Err [List U8] [List U8] "Unsupported atomic expression"
            | T_WriteOne =>
              Err [List U8] [List U8] "Unsupported atomic expression"
            | T_ReadOne =>
              Err [List U8] [List U8] "Unsupported atomic expression"
            | T_EqU8 =>
              Err [List U8] [List U8] "Unsupported atomic expression"
            | T_LtU8 =>
              Err [List U8] [List U8] "Unsupported atomic expression"
            | T_DivU8 =>
              Err [List U8] [List U8] "Unsupported atomic expression"
            | T_ModU8 =>
              Err [List U8] [List U8] "Unsupported atomic expression"
            | T_AddU8 =>
              Err [List U8] [List U8] "Unsupported atomic expression"
            | T_SubU8 =>
              Err [List U8] [List U8] "Unsupported atomic expression"
          }
        | AE_Lam n b => Err [List U8] [List U8] "Unsupported atom: lambda"
        | AE_Call f args => Err [List U8] [List U8] "Unsupported atom: call"
        | AE_Con tag total arity args =>
          Err [List U8] [List U8] "Unsupported atom: constructor"
        | AE_Case scrut arms => Err [List U8] [List U8] "Unsupported atom: case"
        | AE_Let name val body => Err [List U8] [List U8] "Unsupported atom: let"
      }

poly rec emitArgsString =
  \env : List ((List U8), (List U8)) =>
    \args : List AnfExpr =>
      \leading : Bool =>
        matchList
          [AnfExpr]
          [Result (List U8) (List U8)]
          args
          (Ok [List U8] [List U8] "")
          (
            \h : AnfExpr =>
              \t : List AnfExpr =>
                do [Result (List U8) (List U8)] {
                  op <- (atomOperand env h)
                  piece =
                  if [List U8] leading
                    (\u : U8 => append [U8] "i64 " op)
                    (\u : U8 => append [U8] ", i64 " op)
                  rest <- (emitArgsString env t false)
                  return Ok [List U8] [List U8] (append [U8] piece rest)
                }
          )

poly rec emitIndirectCallChain =
  \env : List ((List U8), (List U8)) =>
    \counter : Bin =>
      \instrs : List (List U8) =>
        \closureOp : List U8 =>
          \args : List AnfExpr =>
            matchList
              [AnfExpr]
              [Result (List U8) EmitRes]
              args
              (Ok [List U8] [EmitRes] (MkEmitRes counter instrs closureOp))
              (
                \h : AnfExpr =>
                  \t : List AnfExpr =>
                    do [Result (List U8) EmitRes] {
                      op <- (atomOperand env h)
                      dest = append [U8]
                      "%__ll" (binToDigits counter)
                      castObjLine = concat [U8]
                      {List U8 |
                        "  "
                        dest
                        "_p = inttoptr i64 "
                        closureOp
                        " to ptr\n"
                      }
                      loadFnValLine = concat [U8]
                      {List U8 |
                        "  "
                        dest
                        "_fn_val = call i64 @trip_obj_field(ptr "
                        dest
                        "_p, i64 0)\n"
                      }
                      castFnLine = concat [U8]
                      {List U8 |
                        "  "
                        dest
                        "_fn = inttoptr i64 "
                        dest
                        "_fn_val to ptr\n"
                      }
                      callLine = concat [U8]
                      {List U8 |
                        "  "
                        dest
                        " = call i64 "
                        dest
                        "_fn(i64 "
                        closureOp
                        ", i64 "
                        op
                        ")\n"
                      }
                      counter1 = incBin counter
                      newInstrs = append [List U8] {List U8 | callLine castFnLine loadFnValLine castObjLine} instrs
                      return emitIndirectCallChain env counter1 newInstrs dest t
                    }
              )

poly rec peelBinders =
  \e : AnfExpr =>
    \acc : List (List U8) =>
      match e [((List (List U8)), AnfExpr)] {
        | AE_Lam name body =>
          peelBinders body (append [List U8] acc {List U8 | name})
        | AE_Var name => {List (List U8), AnfExpr | acc, e}
        | AE_Native term => {List (List U8), AnfExpr | acc, e}
        | AE_Call name args => {List (List U8), AnfExpr | acc, e}
        | AE_Con tag total arity args => {List (List U8), AnfExpr | acc, e}
        | AE_Case scrut arms => {List (List U8), AnfExpr | acc, e}
        | AE_Let name val body => {List (List U8), AnfExpr | acc, e}
      }

poly rec emitCaseFieldBinds =
  \env : List ((List U8), (List U8)) =>
    \instrs : List (List U8) =>
      \scrutPtr : List U8 =>
        \armIdx : U8 =>
          \params : List (List U8) =>
            \fieldIdx : U8 =>
              matchList
                [List U8]
                [(List ((List U8), (List U8)), List (List U8))]
                params
                {List ((List U8), (List U8)), List (List U8) | env, instrs}
                (
                  \p : List U8 =>
                    \t : List (List U8) =>
                      let fldVar = concat [U8] {List U8 | scrutPtr "_arm_" (u8ToDigits armIdx) "_fld_" (u8ToDigits fieldIdx)} in
                      let line = concat [U8] {List U8 | "  " fldVar " = call i64 @trip_obj_field(ptr " scrutPtr ", i64 " (u8ToDigits fieldIdx) ")\n"} in
                      emitCaseFieldBinds
                        (
                          cons
                            [((List U8), (List U8))]
                            {List U8, List U8 | p, fldVar}
                            env
                        )
                        (cons [List U8] line instrs)
                        scrutPtr
                        armIdx
                        t
                        (addU8 fieldIdx #u8(1))
                )

poly rec emitCtorFields =
  \env : List ((List U8), (List U8)) =>
    \counter : Bin =>
      \instrs : List (List U8) =>
        \objDest : List U8 =>
          \arity : U8 =>
            \args : List AnfExpr =>
              \idx : U8 =>
                matchList
                  [AnfExpr]
                  [Result (List U8) EmitRes]
                  args
                  (Ok [List U8] [EmitRes] (MkEmitRes counter instrs objDest))
                  (
                    \arg : AnfExpr =>
                      \t : List AnfExpr =>
                        do [Result (List U8) EmitRes] {
                          op <- (atomOperand env arg)
                          obj_ptr = append [U8] objDest
                          "_p"
                          line = concat [U8] {List U8 | "  call void @trip_obj_set_field(ptr " obj_ptr ", i64 " (u8ToDigits idx) ", i64 " op ")\n"}
                          return
                            emitCtorFields
                            env
                            counter
                            (cons [List U8] line instrs)
                            objDest
                            arity
                            t
                            (addU8 idx #u8(1))
                        }
                  )

poly emitAddU8 =
  \env : List ((List U8), (List U8)) =>
    \counter : Bin =>
      \instrs : List (List U8) =>
        \arg1 : AnfExpr =>
          \arg2 : AnfExpr =>
            do [Result (List U8) EmitRes] {
              op1 <- (atomOperand env arg1)
              op2 <- (atomOperand env arg2)
              dest = append [U8]
              "%__ll" (binToDigits counter)
              counter1 = incBin counter
              t1 = concat [U8]
              {List U8 | "  " dest "_t1 = trunc i64 " op1 " to i8\n"}
              t2 = concat [U8]
              {List U8 | "  " dest "_t2 = trunc i64 " op2 " to i8\n"}
              res = concat [U8]
              {List U8 | "  " dest "_res = add i8 " dest "_t1, " dest "_t2\n"}
              ext = concat [U8] {List U8 | "  " dest " = zext i8 " dest "_res to i64\n"}
              return
                Ok
                [List U8]
                [EmitRes]
                (
                  MkEmitRes
                    counter1
                    (append [List U8] {List U8 | ext res t2 t1} instrs)
                    dest
                )
            }

poly emitSubU8 =
  \env : List ((List U8), (List U8)) =>
    \counter : Bin =>
      \instrs : List (List U8) =>
        \arg1 : AnfExpr =>
          \arg2 : AnfExpr =>
            do [Result (List U8) EmitRes] {
              op1 <- (atomOperand env arg1)
              op2 <- (atomOperand env arg2)
              dest = append [U8]
              "%__ll" (binToDigits counter)
              counter1 = incBin counter
              t1 = concat [U8]
              {List U8 | "  " dest "_t1 = trunc i64 " op1 " to i8\n"}
              t2 = concat [U8]
              {List U8 | "  " dest "_t2 = trunc i64 " op2 " to i8\n"}
              res = concat [U8]
              {List U8 | "  " dest "_res = sub i8 " dest "_t1, " dest "_t2\n"}
              ext = concat [U8] {List U8 | "  " dest " = zext i8 " dest "_res to i64\n"}
              return
                Ok
                [List U8]
                [EmitRes]
                (
                  MkEmitRes
                    counter1
                    (append [List U8] {List U8 | ext res t2 t1} instrs)
                    dest
                )
            }

poly emitDivU8 =
  \env : List ((List U8), (List U8)) =>
    \counter : Bin =>
      \instrs : List (List U8) =>
        \arg1 : AnfExpr =>
          \arg2 : AnfExpr =>
            do [Result (List U8) EmitRes] {
              op1 <- (atomOperand env arg1)
              op2 <- (atomOperand env arg2)
              dest = append [U8]
              "%__ll" (binToDigits counter)
              counter1 = incBin counter
              t1 = concat [U8]
              {List U8 | "  " dest "_t1 = trunc i64 " op1 " to i8\n"}
              t2 = concat [U8]
              {List U8 | "  " dest "_t2 = trunc i64 " op2 " to i8\n"}
              zero = concat [U8]
              {List U8 | "  " dest "_zero = icmp eq i8 " dest "_t2, 0\n"}
              safe = concat [U8]
              {List U8 |
                "  "
                dest
                "_safe = select i1 "
                dest
                "_zero, i8 1, i8 "
                dest
                "_t2\n"
              }
              raw = concat [U8]
              {List U8 |
                "  "
                dest
                "_raw = udiv i8 "
                dest
                "_t1, "
                dest
                "_safe\n"
              }
              res = concat [U8]
              {List U8 |
                "  "
                dest
                "_res = select i1 "
                dest
                "_zero, i8 0, i8 "
                dest
                "_raw\n"
              }
              ext = concat [U8] {List U8 | "  " dest " = zext i8 " dest "_res to i64\n"}
              return
                Ok
                [List U8]
                [EmitRes]
                (
                  MkEmitRes
                    counter1
                    (
                      append
                        [List U8]
                        {List U8 | ext res raw safe zero t2 t1}
                        instrs
                    )
                    dest
                )
            }

poly emitModU8 =
  \env : List ((List U8), (List U8)) =>
    \counter : Bin =>
      \instrs : List (List U8) =>
        \arg1 : AnfExpr =>
          \arg2 : AnfExpr =>
            do [Result (List U8) EmitRes] {
              op1 <- (atomOperand env arg1)
              op2 <- (atomOperand env arg2)
              dest = append [U8]
              "%__ll" (binToDigits counter)
              counter1 = incBin counter
              t1 = concat [U8]
              {List U8 | "  " dest "_t1 = trunc i64 " op1 " to i8\n"}
              t2 = concat [U8]
              {List U8 | "  " dest "_t2 = trunc i64 " op2 " to i8\n"}
              zero = concat [U8]
              {List U8 | "  " dest "_zero = icmp eq i8 " dest "_t2, 0\n"}
              safe = concat [U8]
              {List U8 |
                "  "
                dest
                "_safe = select i1 "
                dest
                "_zero, i8 1, i8 "
                dest
                "_t2\n"
              }
              raw = concat [U8]
              {List U8 |
                "  "
                dest
                "_raw = urem i8 "
                dest
                "_t1, "
                dest
                "_safe\n"
              }
              res = concat [U8]
              {List U8 |
                "  "
                dest
                "_res = select i1 "
                dest
                "_zero, i8 0, i8 "
                dest
                "_raw\n"
              }
              ext = concat [U8] {List U8 | "  " dest " = zext i8 " dest "_res to i64\n"}
              return
                Ok
                [List U8]
                [EmitRes]
                (
                  MkEmitRes
                    counter1
                    (
                      append
                        [List U8]
                        {List U8 | ext res raw safe zero t2 t1}
                        instrs
                    )
                    dest
                )
            }

poly emitEqU8 =
  \env : List ((List U8), (List U8)) =>
    \counter : Bin =>
      \instrs : List (List U8) =>
        \arg1 : AnfExpr =>
          \arg2 : AnfExpr =>
            do [Result (List U8) EmitRes] {
              op1 <- (atomOperand env arg1)
              op2 <- (atomOperand env arg2)
              dest = append [U8]
              "%__ll" (binToDigits counter)
              counter1 = incBin counter
              t1 = concat [U8]
              {List U8 | "  " dest "_t1 = trunc i64 " op1 " to i8\n"}
              t2 = concat [U8]
              {List U8 | "  " dest "_t2 = trunc i64 " op2 " to i8\n"}
              cmp = concat [U8]
              {List U8 |
                "  "
                dest
                "_cmp = icmp eq i8 "
                dest
                "_t1, "
                dest
                "_t2\n"
              }
              ext = concat [U8] {List U8 | "  " dest "_zext = zext i1 " dest "_cmp to i64\n" "  " dest " = add i64 " dest "_zext, 1\n"}
              return
                Ok
                [List U8]
                [EmitRes]
                (
                  MkEmitRes
                    counter1
                    (append [List U8] {List U8 | ext cmp t2 t1} instrs)
                    dest
                )
            }

poly emitLtU8 =
  \env : List ((List U8), (List U8)) =>
    \counter : Bin =>
      \instrs : List (List U8) =>
        \arg1 : AnfExpr =>
          \arg2 : AnfExpr =>
            do [Result (List U8) EmitRes] {
              op1 <- (atomOperand env arg1)
              op2 <- (atomOperand env arg2)
              dest = append [U8]
              "%__ll" (binToDigits counter)
              counter1 = incBin counter
              t1 = concat [U8]
              {List U8 | "  " dest "_t1 = trunc i64 " op1 " to i8\n"}
              t2 = concat [U8]
              {List U8 | "  " dest "_t2 = trunc i64 " op2 " to i8\n"}
              cmp = concat [U8]
              {List U8 |
                "  "
                dest
                "_cmp = icmp ult i8 "
                dest
                "_t1, "
                dest
                "_t2\n"
              }
              ext = concat [U8] {List U8 | "  " dest "_zext = zext i1 " dest "_cmp to i64\n" "  " dest " = add i64 " dest "_zext, 1\n"}
              return
                Ok
                [List U8]
                [EmitRes]
                (
                  MkEmitRes
                    counter1
                    (append [List U8] {List U8 | ext cmp t2 t1} instrs)
                    dest
                )
            }

poly emitWriteOne =
  \env : List ((List U8), (List U8)) =>
    \counter : Bin =>
      \instrs : List (List U8) =>
        \byte : AnfExpr =>
          \cont : AnfExpr =>
            do [Result (List U8) EmitRes] {
              op_byte <- (atomOperand env byte)
              return
              match cont [Result (List U8) EmitRes] {
                | AE_Lam contVar contBody =>
                  do [Result (List U8) EmitRes] {
                    suffix = binToDigits counter
                    varName = concat [U8]
                    {List U8 | "%__ll" suffix "_t_write"}
                    t1 = concat [U8]
                    {List U8 | "  " varName " = trunc i64 " op_byte " to i8\n"}
                    line = concat [U8]
                    {List U8 | "  call void @trip_write_one(i8 " varName ")\n"}
                    counter1 = incBin counter
                    lines = append [List U8] {List U8 | line t1} instrs
                    return
                      emitExpr
                      (
                        cons
                          [((List U8), (List U8))]
                          {List U8, List U8 | contVar, "0"}
                          env
                      )
                      counter1
                      lines
                      contBody
                  }
                | AE_Var name =>
                  Err
                    [List U8]
                    [EmitRes]
                    "writeOne expects a lambda continuation"
                | AE_Native term =>
                  Err
                    [List U8]
                    [EmitRes]
                    "writeOne expects a lambda continuation"
                | AE_Call name args =>
                  Err
                    [List U8]
                    [EmitRes]
                    "writeOne expects a lambda continuation"
                | AE_Con tag total arity args =>
                  Err
                    [List U8]
                    [EmitRes]
                    "writeOne expects a lambda continuation"
                | AE_Case scrut arms =>
                  Err
                    [List U8]
                    [EmitRes]
                    "writeOne expects a lambda continuation"
                | AE_Let name val body =>
                  Err
                    [List U8]
                    [EmitRes]
                    "writeOne expects a lambda continuation"
              }
            }

poly emitReadOne =
  \env : List ((List U8), (List U8)) =>
    \counter : Bin =>
      \instrs : List (List U8) =>
        \cont : AnfExpr =>
          match cont [Result (List U8) EmitRes] {
            | AE_Lam contVar contBody =>
              let dest = append [U8] "%__ll" (binToDigits counter) in
              let counter1 = incBin counter in
              let line1 = concat [U8] {List U8 | "  " dest "_r = call i8 @trip_read_one()\n"} in
              let line2 = concat [U8] {List U8 | "  " dest " = zext i8 " dest "_r to i64\n"} in
              let lines = append [List U8] {List U8 | line2 line1} instrs in
              emitExpr
                (
                  cons
                    [((List U8), (List U8))]
                    {List U8, List U8 | contVar, dest}
                    env
                )
                counter1
                lines
                contBody
            | AE_Var name =>
              Err [List U8] [EmitRes] "readOne expects a lambda continuation"
            | AE_Native term =>
              Err [List U8] [EmitRes] "readOne expects a lambda continuation"
            | AE_Call name args =>
              Err [List U8] [EmitRes] "readOne expects a lambda continuation"
            | AE_Con tag total arity args =>
              Err [List U8] [EmitRes] "readOne expects a lambda continuation"
            | AE_Case scrut arms =>
              Err [List U8] [EmitRes] "readOne expects a lambda continuation"
            | AE_Let name val body =>
              Err [List U8] [EmitRes] "readOne expects a lambda continuation"
          }

poly rec hasDot =
  \name : List U8 =>
    matchList
      [U8]
      [Bool]
      name
      false
      (\h : U8 => \t : List U8 => or (eqU8 h #u8(46)) (hasDot t))

poly rec replaceDot =
  \name : List U8 =>
    matchList
      [U8]
      [List U8]
      name
      ""
      (
        \h : U8 =>
          \t : List U8 =>
            if [List U8] (eqU8 h #u8(46))
              (\u : U8 => cons [U8] #u8(95) t)
              (\u : U8 => cons [U8] h (replaceDot t))
      )

poly llvmSymbolName =
  \name : List U8 =>
    if [List U8] (hasDot name)
      (\u : U8 => append [U8] "trip_fn_" (replaceDot name))
      (\u : U8 => name)

poly startsWithLambda =
  \name : List U8 =>
    match name [Bool] {
      | nil => false
      | cons h1 t1 =>
        if [Bool] (eqU8 h1 #u8(95))
          (
            \u : U8 =>
              match t1 [Bool] {
                | nil => false
                | cons h2 t2 =>
                  if [Bool] (eqU8 h2 #u8(95))
                    (
                      \u : U8 =>
                        match t2 [Bool] {
                          | nil => false
                          | cons h3 t3 =>
                            if [Bool] (eqU8 h3 #u8(108))
                              (
                                \u : U8 =>
                                  match t3 [Bool] {
                                    | nil => false
                                    | cons h4 t4 => eqU8 h4 #u8(97)
                                  }
                              )
                              (\u : U8 => false)
                        }
                    )
                    (\u : U8 => false)
              }
          )
          (\u : U8 => false)
    }

-- Closed globals have no per-reference state. Their immutable closure objects
-- live in the LLVM module rather than the process arena; captured lambdas keep
-- using ordinary allocated objects. Both share the runtime's tag/arity/fields ABI.
poly closedGlobalSymbol =
  \name : List U8 => append [U8] "__trip_closed$" (llvmSymbolName name)

poly closedGlobalOperand =
  \name : List U8 =>
    concat
      [U8]
      {List U8 | "ptrtoint (ptr @" (closedGlobalSymbol name) " to i64)"}

poly rec bindGlobalArgs =
  \env : List ((List U8), (List U8)) =>
    \counter : Bin =>
      \instrs : List (List U8) =>
        \args : List AnfExpr =>
          matchList
            [AnfExpr]
            [Result (List U8) BindGlobalArgsRes]
            args
            (
              Ok
                [List U8]
                [BindGlobalArgsRes]
                (MkBindGlobalArgsRes env counter instrs {AnfExpr |})
            )
            (
              \h : AnfExpr =>
                \t : List AnfExpr =>
                  match h [Result (List U8) BindGlobalArgsRes] {
                    | AE_Var n =>
                      match (lookupEnv env n) [Maybe (List U8)] {
                        | Some op =>
                          do [Result (List U8) BindGlobalArgsRes] {
                            res <- (bindGlobalArgs env counter instrs t)
                            MkBindGlobalArgsRes env1 c1 instrs1 restArgs = res
                            return
                              Ok
                              [List U8]
                              [BindGlobalArgsRes]
                              (
                                MkBindGlobalArgsRes
                                  env1
                                  c1
                                  instrs1
                                  (cons [AnfExpr] h restArgs)
                              )
                          }
                        | None =>
                          if [Result (List U8) BindGlobalArgsRes] (startsWithLambda n)
                            (
                              \u : U8 =>
                                let dest = append [U8] "%__ll" (binToDigits counter) in
                                let counter1 = incBin counter in
                                let line = concat [U8] {List U8 | "  " dest " = ptrtoint ptr @" (llvmSymbolName n) " to i64\n"} in
                                let env1 = cons [((List U8), (List U8))] {List U8, List U8 | n, dest} env in
                                let instrs1 = cons [List U8] line instrs in
                                do [Result (List U8) BindGlobalArgsRes] {
                                  res <- (bindGlobalArgs env1 counter1 instrs1 t)
                                  MkBindGlobalArgsRes env2 c2 instrs2 restArgs = res
                                  return
                                    Ok
                                    [List U8]
                                    [BindGlobalArgsRes]
                                    (
                                      MkBindGlobalArgsRes
                                        env2
                                        c2
                                        instrs2
                                        (cons [AnfExpr] (AE_Var n) restArgs)
                                    )
                                }
                            )
                            (
                              \u : U8 =>
                                let env1 = cons [((List U8), (List U8))] {List U8, List U8 | n, (closedGlobalOperand n)} env in
                                do [Result (List U8) BindGlobalArgsRes] {
                                  res <- (bindGlobalArgs env1 counter instrs t)
                                  MkBindGlobalArgsRes env2 c2 instrs2 restArgs = res
                                  return
                                    Ok
                                    [List U8]
                                    [BindGlobalArgsRes]
                                    (
                                      MkBindGlobalArgsRes
                                        env2
                                        c2
                                        instrs2
                                        (cons [AnfExpr] (AE_Var n) restArgs)
                                    )
                                }
                            )
                      }
                    | AE_Native term =>
                      do [Result (List U8) BindGlobalArgsRes] {
                        res <- (bindGlobalArgs env counter instrs t)
                        MkBindGlobalArgsRes env1 c1 instrs1 restArgs = res
                        return
                          Ok
                          [List U8]
                          [BindGlobalArgsRes]
                          (
                            MkBindGlobalArgsRes
                              env1
                              c1
                              instrs1
                              (cons [AnfExpr] h restArgs)
                          )
                      }
                    | AE_Lam n b =>
                      Err
                        [List U8]
                        [BindGlobalArgsRes]
                        "Unsupported argument: lambda"
                    | AE_Call f args1 =>
                      Err
                        [List U8]
                        [BindGlobalArgsRes]
                        "Unsupported argument: call"
                    | AE_Con tag total arity args1 =>
                      Err
                        [List U8]
                        [BindGlobalArgsRes]
                        "Unsupported argument: constructor"
                    | AE_Case scrut arms =>
                      Err
                        [List U8]
                        [BindGlobalArgsRes]
                        "Unsupported argument: case"
                    | AE_Let name val body =>
                      Err
                        [List U8]
                        [BindGlobalArgsRes]
                        "Unsupported argument: let"
                  }
            )

poly rec emitCallExpr =
  \env : List ((List U8), (List U8)) =>
    \counter : Bin =>
      \instrs : List (List U8) =>
        \f : List U8 =>
          \args : List AnfExpr =>
            cond [Result (List U8) EmitRes] {
              | or (eqListU8 f "addU8") (eqListU8 f "Prelude.addU8") =>
                match args [Result (List U8) EmitRes] {
                  | nil =>
                    Err [List U8] [EmitRes] "addU8 expects two arguments"
                  | cons arg1 rest1 =>
                    match rest1 [Result (List U8) EmitRes] {
                      | nil =>
                        Err [List U8] [EmitRes] "addU8 expects two arguments"
                      | cons arg2 rest2 =>
                        match rest2 [Result (List U8) EmitRes] {
                          | nil => emitAddU8 env counter instrs arg1 arg2
                          | cons h1 t1 =>
                            Err
                              [List U8]
                              [EmitRes]
                              "addU8 expects two arguments"
                        }
                    }
                }
              | or (eqListU8 f "subU8") (eqListU8 f "Prelude.subU8") =>
                match args [Result (List U8) EmitRes] {
                  | nil =>
                    Err [List U8] [EmitRes] "subU8 expects two arguments"
                  | cons arg1 rest1 =>
                    match rest1 [Result (List U8) EmitRes] {
                      | nil =>
                        Err [List U8] [EmitRes] "subU8 expects two arguments"
                      | cons arg2 rest2 =>
                        match rest2 [Result (List U8) EmitRes] {
                          | nil => emitSubU8 env counter instrs arg1 arg2
                          | cons h1 t1 =>
                            Err
                              [List U8]
                              [EmitRes]
                              "subU8 expects two arguments"
                        }
                    }
                }
              | or (eqListU8 f "divU8") (eqListU8 f "Prelude.divU8") =>
                match args [Result (List U8) EmitRes] {
                  | nil =>
                    Err [List U8] [EmitRes] "divU8 expects two arguments"
                  | cons arg1 rest1 =>
                    match rest1 [Result (List U8) EmitRes] {
                      | nil =>
                        Err [List U8] [EmitRes] "divU8 expects two arguments"
                      | cons arg2 rest2 =>
                        match rest2 [Result (List U8) EmitRes] {
                          | nil => emitDivU8 env counter instrs arg1 arg2
                          | cons h1 t1 =>
                            Err
                              [List U8]
                              [EmitRes]
                              "divU8 expects two arguments"
                        }
                    }
                }
              | or (eqListU8 f "modU8") (eqListU8 f "Prelude.modU8") =>
                match args [Result (List U8) EmitRes] {
                  | nil =>
                    Err [List U8] [EmitRes] "modU8 expects two arguments"
                  | cons arg1 rest1 =>
                    match rest1 [Result (List U8) EmitRes] {
                      | nil =>
                        Err [List U8] [EmitRes] "modU8 expects two arguments"
                      | cons arg2 rest2 =>
                        match rest2 [Result (List U8) EmitRes] {
                          | nil => emitModU8 env counter instrs arg1 arg2
                          | cons h1 t1 =>
                            Err
                              [List U8]
                              [EmitRes]
                              "modU8 expects two arguments"
                        }
                    }
                }
              | or (eqListU8 f "eqU8") (eqListU8 f "Prelude.eqU8") =>
                match args [Result (List U8) EmitRes] {
                  | nil =>
                    Err [List U8] [EmitRes] "eqU8 expects two arguments"
                  | cons arg1 rest1 =>
                    match rest1 [Result (List U8) EmitRes] {
                      | nil =>
                        Err [List U8] [EmitRes] "eqU8 expects two arguments"
                      | cons arg2 rest2 =>
                        match rest2 [Result (List U8) EmitRes] {
                          | nil => emitEqU8 env counter instrs arg1 arg2
                          | cons h1 t1 =>
                            Err [List U8] [EmitRes] "eqU8 expects two arguments"
                        }
                    }
                }
              | or (eqListU8 f "ltU8") (eqListU8 f "Prelude.ltU8") =>
                match args [Result (List U8) EmitRes] {
                  | nil =>
                    Err [List U8] [EmitRes] "ltU8 expects two arguments"
                  | cons arg1 rest1 =>
                    match rest1 [Result (List U8) EmitRes] {
                      | nil =>
                        Err [List U8] [EmitRes] "ltU8 expects two arguments"
                      | cons arg2 rest2 =>
                        match rest2 [Result (List U8) EmitRes] {
                          | nil => emitLtU8 env counter instrs arg1 arg2
                          | cons h1 t1 =>
                            Err [List U8] [EmitRes] "ltU8 expects two arguments"
                        }
                    }
                }
              | or (eqListU8 f "writeOne") (or (eqListU8 f "Prelude.writeOne") (eqListU8 f ".")) =>
                match args [Result (List U8) EmitRes] {
                  | nil =>
                    Err [List U8] [EmitRes] "writeOne expects two arguments"
                  | cons arg1 rest1 =>
                    match rest1 [Result (List U8) EmitRes] {
                      | nil =>
                        Err [List U8] [EmitRes] "writeOne expects two arguments"
                      | cons arg2 rest2 =>
                        match rest2 [Result (List U8) EmitRes] {
                          | nil => emitWriteOne env counter instrs arg1 arg2
                          | cons h1 t1 =>
                            Err
                              [List U8]
                              [EmitRes]
                              "writeOne expects two arguments"
                        }
                    }
                }
              | or (eqListU8 f "readOne") (or (eqListU8 f "Prelude.readOne") (eqListU8 f ",")) =>
                match args [Result (List U8) EmitRes] {
                  | nil =>
                    Err [List U8] [EmitRes] "readOne expects one argument"
                  | cons arg1 rest1 =>
                    match rest1 [Result (List U8) EmitRes] {
                      | nil => emitReadOne env counter instrs arg1
                      | cons h1 t1 =>
                        Err [List U8] [EmitRes] "readOne expects one argument"
                    }
                }
              | eqListU8 f "trip_obj_field" =>
                match args [Result (List U8) EmitRes] {
                  | nil =>
                    Err
                      [List U8]
                      [EmitRes]
                      "trip_obj_field expects two arguments"
                  | cons arg1 rest1 =>
                    match rest1 [Result (List U8) EmitRes] {
                      | nil =>
                        Err
                          [List U8]
                          [EmitRes]
                          "trip_obj_field expects two arguments"
                      | cons arg2 rest2 =>
                        match rest2 [Result (List U8) EmitRes] {
                          | nil =>
                            do [Result (List U8) EmitRes] {
                              op1 <- (atomOperand env arg1)
                              op2 <- (atomOperand env arg2)
                              dest = append [U8]
                              "%__ll" (binToDigits counter)
                              counter1 = incBin counter
                              castLine = concat [U8]
                              {List U8 |
                                "  "
                                dest
                                "_p = inttoptr i64 "
                                op1
                                " to ptr\n"
                              }
                              callLine = concat [U8]
                              {List U8 |
                                "  "
                                dest
                                " = call i64 @trip_obj_field(ptr "
                                dest
                                "_p, i64 "
                                op2
                                ")\n"
                              }
                              newInstrs = append [List U8] {List U8 | callLine castLine} instrs
                              return
                                Ok
                                [List U8]
                                [EmitRes]
                                (MkEmitRes counter1 newInstrs dest)
                            }
                          | cons h2 t2 =>
                            Err
                              [List U8]
                              [EmitRes]
                              "trip_obj_field expects two arguments"
                        }
                    }
                }
              | otherwise =>
                do [Result (List U8) EmitRes] {
                  res <- (bindGlobalArgs env counter instrs args)
                  MkBindGlobalArgsRes env1 counter1 instrs1 args1 = res
                  return
                  if [Result (List U8) EmitRes] (startsWithLambda f)
                    (
                      \u10 : U8 =>
                        do [Result (List U8) EmitRes] {
                          argStr <- (emitArgsString env1 args1 true)
                          dest = append [U8]
                          "%__ll" (binToDigits counter1)
                          counter2 = incBin counter1
                          line = concat [U8] {List U8 | "  " dest " = call i64 @" (llvmSymbolName f) "(" argStr ")\n"}
                          return
                            Ok
                            [List U8]
                            [EmitRes]
                            (
                              MkEmitRes
                                counter2
                                (cons [List U8] line instrs1)
                                dest
                            )
                        }
                    )
                    (
                      \u10 : U8 =>
                        match (lookupEnv env1 f) [Result (List U8) EmitRes] {
                          | Some closureOp =>
                            emitIndirectCallChain
                              env1
                              counter1
                              instrs1
                              closureOp
                              args1
                          | None =>
                            if [Result (List U8) EmitRes] (eqListU8 f "_")
                              (
                                \u11 : U8 =>
                                  Err
                                    [List U8]
                                    [EmitRes]
                                    "Indirect call to _ not supported without closure variable"
                              )
                              (
                                \u11 : U8 =>
                                  do [Result (List U8) EmitRes] {
                                    argStr <- (emitArgsString env1 args1 false)
                                    dest = append [U8]
                                    "%__ll" (binToDigits counter1)
                                    counter2 = incBin counter1
                                    line = concat [U8] {List U8 | "  " dest " = call i64 @" (llvmSymbolName f) "(i64 0" argStr ")\n"}
                                    return
                                      Ok
                                      [List U8]
                                      [EmitRes]
                                      (
                                        MkEmitRes
                                          counter2
                                          (cons [List U8] line instrs1)
                                          dest
                                      )
                                  }
                              )
                        }
                    )
                }
            }

poly rec emitExpr =
  \env : List ((List U8), (List U8)) =>
    \counter : Bin =>
      \instrs : List (List U8) =>
        \e : AnfExpr =>
          match e [Result (List U8) EmitRes] {
            | AE_Var n =>
              match (lookupEnv env n) [Result (List U8) EmitRes] {
                | None =>
                  if [Result (List U8) EmitRes] (startsWithLambda n)
                    (
                      \u : U8 =>
                        do [Result (List U8) EmitRes] {
                          dest = append [U8]
                          "%__ll" (binToDigits counter)
                          counter1 = incBin counter
                          line = concat [U8] {List U8 | "  " dest " = ptrtoint ptr @" (llvmSymbolName n) " to i64\n"}
                          return
                            Ok
                            [List U8]
                            [EmitRes]
                            (
                              MkEmitRes
                                counter1
                                (cons [List U8] line instrs)
                                dest
                            )
                        }
                    )
                    (
                      \u : U8 =>
                        Ok
                          [List U8]
                          [EmitRes]
                          (MkEmitRes counter instrs (closedGlobalOperand n))
                    )
                | Some op =>
                  Ok [List U8] [EmitRes] (MkEmitRes counter instrs op)
              }
            | AE_Native t =>
              match t [Result (List U8) EmitRes] {
                | T_Byte b =>
                  Ok
                    [List U8]
                    [EmitRes]
                    (MkEmitRes counter instrs (u8ToDigits b))
                | T_S =>
                  Err [List U8] [EmitRes] "Unsupported native expression"
                | T_K =>
                  Err [List U8] [EmitRes] "Unsupported native expression"
                | T_I =>
                  Err [List U8] [EmitRes] "Unsupported native expression"
                | T_B =>
                  Err [List U8] [EmitRes] "Unsupported native expression"
                | T_C =>
                  Err [List U8] [EmitRes] "Unsupported native expression"
                | T_SPrime =>
                  Err [List U8] [EmitRes] "Unsupported native expression"
                | T_BPrime =>
                  Err [List U8] [EmitRes] "Unsupported native expression"
                | T_CPrime =>
                  Err [List U8] [EmitRes] "Unsupported native expression"
                | T_WriteOne =>
                  Err [List U8] [EmitRes] "Unsupported native expression"
                | T_ReadOne =>
                  Err [List U8] [EmitRes] "Unsupported native expression"
                | T_EqU8 =>
                  Err [List U8] [EmitRes] "Unsupported native expression"
                | T_LtU8 =>
                  Err [List U8] [EmitRes] "Unsupported native expression"
                | T_DivU8 =>
                  Err [List U8] [EmitRes] "Unsupported native expression"
                | T_ModU8 =>
                  Err [List U8] [EmitRes] "Unsupported native expression"
                | T_AddU8 =>
                  Err [List U8] [EmitRes] "Unsupported native expression"
                | T_SubU8 =>
                  Err [List U8] [EmitRes] "Unsupported native expression"
              }
            | AE_Lam n b =>
              Err [List U8] [EmitRes] "Unsupported expression: lambda"
            | AE_Call f args => emitCallExpr env counter instrs f args
            | AE_Con tag total arity args =>
              do [Result (List U8) EmitRes] {
                res <- (bindGlobalArgs env counter instrs args)
                MkBindGlobalArgsRes env1 counter1 instrs1 args1 = res
                dest = append [U8]
                "%__ll" (binToDigits counter1)
                counter2 = incBin counter1
                allocLine = concat [U8]
                {List U8 |
                  "  "
                  dest
                  "_p = call ptr @trip_alloc_obj(i64 "
                  (u8ToDigits tag)
                  ", i64 "
                  (u8ToDigits arity)
                  ")\n"
                }
                castLine = concat [U8]
                {List U8 | "  " dest " = ptrtoint ptr " dest "_p to i64\n"}
                initialInstrs = append [List U8] {List U8 | castLine allocLine} instrs1
                return emitCtorFields env1 counter2 initialInstrs dest arity args1 #u8(0)
              }
            | AE_Case scrut arms =>
              do [Result (List U8) EmitRes] {
                op_scrut <- (atomOperand env scrut)
                caseId = binToDigits counter
                counter1 = incBin counter
                caseVar = append [U8]
                "%__case_res_" caseId
                scrutPtr = append [U8]
                "%__scrut_ptr_" caseId
                tagVar = append [U8]
                "%__tag_" caseId
                allocLine = concat [U8]
                {List U8 | "  " caseVar " = alloca i64\n"}
                castLine = concat [U8]
                {List U8 |
                  "  "
                  scrutPtr
                  " = inttoptr i64 "
                  op_scrut
                  " to ptr\n"
                }
                tagLine = concat [U8]
                {List U8 |
                  "  "
                  tagVar
                  " = call i64 @trip_obj_tag(ptr "
                  scrutPtr
                  ")\n"
                }
                switchHead = concat [U8]
                {List U8 |
                  "  switch i64 "
                  tagVar
                  ", label %case_"
                  caseId
                  "_unreachable [\n"
                }
                switchInstr = concat [U8]
                {List U8 |
                  switchHead
                  (buildCaseTable caseId arms #u8(0))
                  "  ]\n"
                }
                initialInstrs = append [List U8] {List U8 | switchInstr tagLine castLine allocLine} instrs
                return emitCaseArms env counter1 initialInstrs caseVar scrutPtr caseId arms #u8(0)
              }
            | AE_Let name val body =>
              do [Result (List U8) EmitRes] {
                midRes <- (emitExpr env counter instrs val)
                MkEmitRes c1 i1 vop = midRes
                return
                  emitExpr
                  (
                    cons
                      [((List U8), (List U8))]
                      {List U8, List U8 | name, vop}
                      env
                  )
                  c1
                  i1
                  body
              }
          }

poly rec buildCaseTable =
  \caseId : List U8 =>
    \arms : List AnfExpr =>
      \idx : U8 =>
        matchList
          [AnfExpr]
          [List U8]
          arms
          ""
          (
            \arm : AnfExpr =>
              \t : List AnfExpr =>
                concat
                  [U8]
                  {List U8 |
                    "    i64 "
                    (u8ToDigits idx)
                    ", label %case_"
                    caseId
                    "_arm_"
                    (u8ToDigits idx)
                    "\n"
                    (buildCaseTable caseId t (addU8 idx #u8(1)))
                  }
          )

poly rec emitCaseArms =
  \env : List ((List U8), (List U8)) =>
    \counter : Bin =>
      \instrs : List (List U8) =>
        \caseVar : List U8 =>
          \scrutPtr : List U8 =>
            \caseId : List U8 =>
              \arms : List AnfExpr =>
                \idx : U8 =>
                  matchList
                    [AnfExpr]
                    [Result (List U8) EmitRes]
                    arms
                    (
                      let unreachableLabel = concat [U8] {List U8 | "case_" caseId "_unreachable:\n"} in
                      let unreachableBody = "  unreachable\n" in
                      let mergeLabel = concat [U8] {List U8 | "case_" caseId "_merge:\n"} in
                      let mergeLoad = concat [U8] {List U8 | "  " caseVar "_val = load i64, ptr " caseVar "\n"} in
                      let combinedBinds = append [List U8] {List U8 | mergeLoad mergeLabel unreachableBody unreachableLabel} instrs in
                      Ok
                        [List U8]
                        [EmitRes]
                        (
                          MkEmitRes
                            counter
                            combinedBinds
                            (append [U8] caseVar "_val")
                        )
                    )
                    (
                      \arm : AnfExpr =>
                        \t : List AnfExpr =>
                          match (peelBinders arm {List U8 |}) [(List (List U8), AnfExpr)] {
                            | MkPair params body =>
                              let armLabel = concat [U8] {List U8 | "case_" caseId "_arm_" (u8ToDigits idx)} in
                              match (emitCaseFieldBinds env {List U8 |} scrutPtr idx params #u8(0)) [(List ((List U8), (List U8)), List (List U8))] {
                                | MkPair armEnv armInstrs =>
                                  let labelLine = append [U8] armLabel ":\n" in
                                  let combinedInstrs = append [List U8] (reverse [List U8] armInstrs) (cons [List U8] labelLine instrs) in
                                  do [Result (List U8) EmitRes] {
                                    armRes <- (emitExpr armEnv counter combinedInstrs body)
                                    MkEmitRes c1 i1 vop = armRes
                                    storeLine = concat [U8]
                                    {List U8 |
                                      "  store i64 "
                                      vop
                                      ", ptr "
                                      caseVar
                                      "\n"
                                    }
                                    jumpLine = concat [U8]
                                    {List U8 |
                                      "  br label %case_"
                                      caseId
                                      "_merge\n"
                                    }
                                    nextInstrs = append [List U8] {List U8 | jumpLine storeLine} i1
                                    return
                                      emitCaseArms
                                      env
                                      c1
                                      nextInstrs
                                      caseVar
                                      scrutPtr
                                      caseId
                                      t
                                      (addU8 idx #u8(1))
                                  }
                              }
                          }
                    )

poly rec paramDeclsString =
  \params : List (List U8) =>
    \leading : Bool =>
      matchList
        [List U8]
        [List U8]
        params
        ""
        (
          \h : List U8 =>
            \t : List (List U8) =>
              let piece = if [List U8] leading (\u : U8 => append [U8] "i64 %" h) (\u : U8 => append [U8] ", i64 %" h) in
              append [U8] piece (paramDeclsString t false)
        )

poly rec paramEnv =
  \params : List (List U8) =>
    matchList
      [List U8]
      [List ((List U8), (List U8))]
      params
      {((List U8), (List U8)) |}
      (
        \h : List U8 =>
          \t : List (List U8) =>
            cons
              [((List U8), (List U8))]
              {List U8, List U8 | h, (append [U8] "%" h)}
              (paramEnv t)
      )

poly rec joinLines =
  \acc : List U8 =>
    \lines : List (List U8) =>
      matchList
        [List U8]
        [List U8]
        lines
        acc
        (\h : List U8 => \t : List (List U8) => joinLines (append [U8] h acc) t)

poly emitFunc =
  \fn : AnfFunc =>
    do [Result (List U8) (List U8)] {
      MkAnfFunc name params body = fn
      paramsWithEnv =
      if [List (List U8)] (startsWithLambda name)
        (\u : U8 => params)
        (\u : U8 => cons [List U8] "dummy_env" params)
      return
      match (emitExpr (paramEnv paramsWithEnv) BZ {List U8 |} body) [Result (List U8) (List U8)] {
        | Err e =>
          Err [List U8] [List U8] (concat [U8] {List U8 | "[fn " name "] " e})
        | Ok res =>
          do [Result (List U8) (List U8)] {
            MkEmitRes c instrs op = res
            instrText = joinLines "" instrs
            return
              Ok
              [List U8]
              [List U8]
              (
                concat
                  [U8]
                  {List U8 |
                    "define i64 @"
                    (llvmSymbolName name)
                    "("
                    (paramDeclsString paramsWithEnv true)
                    ") {\n__entry:\n"
                    instrText
                    "  ret i64 "
                    op
                    "\n}\n\n"
                  }
              )
          }
      }
    }

poly rec emitFuncsAcc =
  \acc : List (List U8) =>
    \fns : List AnfFunc =>
      matchList
        [AnfFunc]
        [Result (List U8) (List (List U8))]
        fns
        (Ok [List U8] [List (List U8)] acc)
        (
          \h : AnfFunc =>
            \t : List AnfFunc =>
              do [Result (List U8) (List (List U8))] {
                block <- (emitFunc h)
                return emitFuncsAcc (cons [List U8] block acc) t
              }
        )

poly emitFuncs =
  \fns : List AnfFunc =>
    \suffix : List U8 =>
      do [Result (List U8) (List U8)] {
        blocks <- (emitFuncsAcc {List U8 |} fns)
        return Ok [List U8] [List U8] (joinLines suffix blocks)
      }

poly rec nameMember =
  \name : List U8 =>
    \names : List (List U8) =>
      match names [Bool] {
        | nil => false
        | cons h t => or (eqListU8 name h) (nameMember name t)
      }

-- Collect only value references: direct known-symbol calls do not need a
-- closure. Scope follows the same binders as emission, including case arms.
-- An AVL set bounds duplicate-name lookup; the ordered cons-list preserves
-- first-encounter ordering without copying the previously found names.
poly rec collectClosedExpr =
  \bound : List (List U8) =>
    \found : ClosedGlobals =>
      \e : AnfExpr =>
        match e [ClosedGlobals] {
          | AE_Var n =>
            if [ClosedGlobals] (or (nameMember n bound) (startsWithLambda n))
              (\u : U8 => found)
              (
                \u : U8 =>
                  match found [ClosedGlobals] {
                    | MkClosedGlobals seen globals =>
                      match (bridgeAvlLookup [U8] n seen) [ClosedGlobals] {
                        | Some value => found
                        | None =>
                          MkClosedGlobals
                            (bridgeAvlInsert [U8] n #u8(0) seen)
                            (cons [List U8] n globals)
                      }
                  }
              )
          | AE_Native t => found
          | AE_Lam n body =>
            collectClosedExpr (cons [List U8] n bound) found body
          | AE_Call f args => collectClosedArgs bound found args
          | AE_Con tag total arity args => collectClosedArgs bound found args
          | AE_Case scrut arms =>
            collectClosedArgs bound (collectClosedExpr bound found scrut) arms
          | AE_Let n val body =>
            collectClosedExpr
              (cons [List U8] n bound)
              (collectClosedExpr bound found val)
              body
        }

poly rec collectClosedArgs =
  \bound : List (List U8) =>
    \found : ClosedGlobals =>
      \args : List AnfExpr =>
        match args [ClosedGlobals] {
          | nil => found
          | cons h t =>
            collectClosedArgs bound (collectClosedExpr bound found h) t
        }

poly rec collectClosedFuncs =
  \found : ClosedGlobals =>
    \funcs : List AnfFunc =>
      match funcs [ClosedGlobals] {
        | nil => found
        | cons h t =>
          match h [ClosedGlobals] {
            | MkAnfFunc name params body =>
              collectClosedFuncs (collectClosedExpr params found body) t
          }
      }

poly collectClosedNames =
  \funcs : List AnfFunc =>
    match (collectClosedFuncs (MkClosedGlobals (Empty [U8]) {List U8 |}) funcs) [List (List U8)] {
      | MkClosedGlobals seen names => names
    }

poly rec buildGlobalIndex =
  \index : BridgeAvl (List (List U8)) =>
    \funcs : List AnfFunc =>
      match funcs [BridgeAvl (List (List U8))] {
        | nil => index
        | cons h t =>
          match h [BridgeAvl (List (List U8))] {
            | MkAnfFunc n params body =>
              buildGlobalIndex
                (bridgeAvlInsert [List (List U8)] n params index)
                t
          }
      }

poly lookupGlobalParams =
  \name : List U8 =>
    \index : BridgeAvl (List (List U8)) => bridgeAvlLookup [List (List U8)] name index

poly rec argsMatchParams =
  \args : List AnfExpr =>
    \params : List (List U8) =>
      match args [Bool] {
        | nil =>
          match params [Bool] {
            | nil => true
            | cons p ps => false
          }
        | cons h t =>
          match params [Bool] {
            | nil => false
            | cons p ps => argsMatchParams t ps
          }
      }

-- The direct-call ABI is valid only for saturated known globals. Turn partial
-- and excess application into the unary closure ABI before emitting any LLVM.
-- '$' cannot appear in source identifiers, so this local never captures a user
-- binding. Zero-arity globals are thunks: evaluate them before applying extras.
poly rec prepareCallExpr =
  \funcs : BridgeAvl (List (List U8)) =>
    \bound : List (List U8) =>
      \e : AnfExpr =>
        match e [AnfExpr] {
          | AE_Var n => e
          | AE_Native t => e
          | AE_Lam n body =>
            AE_Lam n (prepareCallExpr funcs (cons [List U8] n bound) body)
          | AE_Call f args =>
            let args1 = prepareCallArgs funcs bound args in
            if [AnfExpr] (or (nameMember f bound) (startsWithLambda f))
              (\u : U8 => AE_Call f args1)
              (
                \u : U8 =>
                  match (lookupGlobalParams f funcs) [AnfExpr] {
                    | None => AE_Call f args1
                    | Some params =>
                      if [AnfExpr] (argsMatchParams args1 params)
                        (\u1 : U8 => AE_Call f args1)
                        (
                          \u1 : U8 =>
                            let value = match params [AnfExpr] {| nil => AE_Call f {AnfExpr |} | cons p ps => AE_Var f} in
                            AE_Let
                              "__trip_callee$"
                              value
                              (AE_Call "__trip_callee$" args1)
                        )
                  }
              )
          | AE_Con tag total arity args =>
            AE_Con tag total arity (prepareCallArgs funcs bound args)
          | AE_Case scrut arms =>
            AE_Case
              (prepareCallExpr funcs bound scrut)
              (prepareCallArgs funcs bound arms)
          | AE_Let n val body =>
            AE_Let
              n
              (prepareCallExpr funcs bound val)
              (prepareCallExpr funcs (cons [List U8] n bound) body)
        }

poly rec prepareCallArgs =
  \funcs : BridgeAvl (List (List U8)) =>
    \bound : List (List U8) =>
      \args : List AnfExpr =>
        match args [List AnfExpr] {
          | nil => {AnfExpr |}
          | cons h t =>
            cons
              [AnfExpr]
              (prepareCallExpr funcs bound h)
              (prepareCallArgs funcs bound t)
        }

poly rec prepareCallFuncs =
  \globals : BridgeAvl (List (List U8)) =>
    \funcs : List AnfFunc =>
      match funcs [List AnfFunc] {
        | nil => {AnfFunc |}
        | cons h t =>
          match h [List AnfFunc] {
            | MkAnfFunc name params body =>
              cons
                [AnfFunc]
                (MkAnfFunc name params (prepareCallExpr globals params body))
                (prepareCallFuncs globals t)
          }
      }

poly rec namesLength =
  \names : List (List U8) =>
    match names [Bin] {
      | nil => BZ
      | cons h t => incBin (namesLength t)
    }

poly currySymbol =
  \name : List U8 =>
    \step : Bin =>
      concat
        [U8]
        {List U8 | "__trip_curry$" (llvmSymbolName name) "$" (binToDigits step)}

poly needsCurry =
  \params : List (List U8) =>
    match params [Bool] {
      | nil => false
      | cons h t =>
        match t [Bool] {
          | nil => false
          | cons h1 t1 => true
        }
    }

poly rec curryLoads =
  \captured : List (List U8) =>
    \index : Bin =>
      match captured [List U8] {
        | nil => ""
        | cons h t =>
          append
            [U8]
            (
              concat
                [U8]
                {List U8 |
                  "  %__curry_capture"
                  (binToDigits index)
                  " = call i64 @trip_obj_field(ptr %__curry_env_p, i64 "
                  (binToDigits index)
                  ")\n"
                }
            )
            (curryLoads t (incBin index))
      }

poly rec curryStores =
  \captured : List (List U8) =>
    \index : Bin =>
      match captured [List U8] {
        | nil =>
          concat
            [U8]
            {List U8 |
              "  call void @trip_obj_set_field(ptr %__curry_next_p, i64 "
              (binToDigits index)
              ", i64 %__curry_arg)\n"
            }
        | cons h t =>
          append
            [U8]
            (
              concat
                [U8]
                {List U8 |
                  "  call void @trip_obj_set_field(ptr %__curry_next_p, i64 "
                  (binToDigits index)
                  ", i64 %__curry_capture"
                  (binToDigits index)
                  ")\n"
                }
            )
            (curryStores t (incBin index))
      }

poly rec curryCallArgs =
  \captured : List (List U8) =>
    \index : Bin =>
      match captured [List U8] {
        | nil => "i64 %__curry_arg"
        | cons h t =>
          concat
            [U8]
            {List U8 |
              "i64 %__curry_capture"
              (binToDigits index)
              ", "
              (curryCallArgs t (incBin index))
            }
      }

-- Direct globals take every source argument in one call. A first-class value
-- follows the unary closure ABI instead, so multi-argument globals need curry
-- adapters. Each incomplete application creates a fresh immutable environment;
-- the shared closed object is never written, and the final step calls directly.
poly rec emitCurrySteps =
  \name : List U8 =>
    \remaining : List (List U8) =>
      \captured : List (List U8) =>
        \step : Bin =>
          match remaining [List U8] {
            | nil => ""
            | cons h t =>
              let nextStep = incBin step in
              let header = concat [U8] {List U8 | "define private i64 @" (currySymbol name step) "(i64 %__curry_env, i64 %__curry_arg) {\n__entry:\n" "  %__curry_env_p = inttoptr i64 %__curry_env to ptr\n" (curryLoads captured (incBin BZ))} in
              match t [List U8] {
                | nil =>
                  concat
                    [U8]
                    {List U8 |
                      header
                      "  %__curry_result = call i64 @"
                      (llvmSymbolName name)
                      "(i64 0, "
                      (curryCallArgs captured (incBin BZ))
                      ")\n  ret i64 %__curry_result\n}\n\n"
                    }
                | cons h1 t1 =>
                  concat
                    [U8]
                    {List U8 |
                      header
                      "  %__curry_next_p = call ptr @trip_alloc_obj(i64 0, i64 "
                      (binToDigits (incBin (incBin (namesLength captured))))
                      ")\n  call void @trip_obj_set_field(ptr %__curry_next_p, i64 0, i64 ptrtoint (ptr @"
                      (currySymbol name nextStep)
                      " to i64))\n"
                      (curryStores captured (incBin BZ))
                      "  %__curry_result = ptrtoint ptr %__curry_next_p to i64\n"
                      "  ret i64 %__curry_result\n}\n\n"
                      (
                        emitCurrySteps
                          name
                          t
                          (cons [List U8] h captured)
                          nextStep
                      )
                    }
              }
          }

poly rec emitClosedGlobals =
  \funcs : BridgeAvl (List (List U8)) =>
    \globals : List (List U8) =>
      match globals [List U8] {
        | nil => ""
        | cons h t =>
          let params = match (lookupGlobalParams h funcs) [List (List U8)] {| None => {List U8 |} | Some ps => ps} in
          let curried = needsCurry params in
          let entrySymbol = if [List U8] curried (\u : U8 => currySymbol h BZ) (\u : U8 => llvmSymbolName h) in
          concat
            [U8]
            {List U8 |
              "@"
              (closedGlobalSymbol h)
              " = private constant { i64, i64, [1 x i64] } { i64 0, i64 1, [1 x i64] [i64 ptrtoint (ptr @"
              entrySymbol
              " to i64)] }, align 8\n\n"
              (
                if [List U8] curried
                  (\u : U8 => emitCurrySteps h params {List U8 |} BZ)
                  (\u : U8 => "")
              )
              (emitClosedGlobals funcs t)
            }
      }

poly rec validateClosedGlobals =
  \index : BridgeAvl (List (List U8)) =>
    \globals : List (List U8) =>
      match globals [Result (List U8) U8] {
        | nil => Ok [List U8] [U8] #u8(0)
        | cons h t =>
          match (lookupGlobalParams h index) [Result (List U8) U8] {
            | None =>
              Err
                [List U8]
                [U8]
                (append [U8] "Unknown global function value: " h)
            | Some params =>
              match params [Result (List U8) U8] {
                | nil =>
                  Err
                    [List U8]
                    [U8]
                    (
                      append
                        [U8]
                        "Unevaluated zero-arity global function value: "
                        h
                    )
                | cons p ps => validateClosedGlobals index t
              }
          }
      }

-- Function blocks are prepended onto the suffix directly. Appending a footer
-- after emission would copy the entire LLVM byte list through append's reverse
-- and appendAcc passes, even though only the small footer is new.
poly emitProgramWithSuffix =
  \prog : AnfProgram =>
    \suffix : List U8 =>
      do [Result (List U8) (List U8)] {
        MkAnfProgram funcs entry = prog
        index = buildGlobalIndex (Empty [List (List U8)]) funcs
        prepared = prepareCallFuncs index funcs
        llvm <- (emitFuncs prepared suffix)
        globals = collectClosedNames prepared
        return
        do [Result (List U8) (List U8)] {
          u <- (validateClosedGlobals index globals)
          return
            Ok
            [List U8]
            [List U8]
            (append [U8] (emitClosedGlobals index globals) llvm)
        }
      }

poly emitProgram =
  \prog : AnfProgram => emitProgramWithSuffix prog ""

poly rec exprUsesReadWrite =
  \e : AnfExpr =>
    match e [Bool] {
      | AE_Var n => false
      | AE_Native t => false
      | AE_Lam n b => exprUsesReadWrite b
      | AE_Call f args =>
        or
          (
            or
              (eqListU8 f "writeOne")
              (
                or
                  (eqListU8 f "Prelude.writeOne")
                  (or (eqListU8 f "readOne") (eqListU8 f "Prelude.readOne"))
              )
          )
          (listAnyUsesReadWrite args)
      | AE_Con tag total arity args => listAnyUsesReadWrite args
      | AE_Case scrut arms =>
        or (exprUsesReadWrite scrut) (listAnyUsesReadWrite arms)
      | AE_Let name val body =>
        or (exprUsesReadWrite val) (exprUsesReadWrite body)
    }

poly rec listAnyUsesReadWrite =
  \es : List AnfExpr =>
    matchList
      [AnfExpr]
      [Bool]
      es
      false
      (
        \h : AnfExpr =>
          \t : List AnfExpr => or (exprUsesReadWrite h) (listAnyUsesReadWrite t)
      )

poly rec funcsUseReadWrite =
  \fns : List AnfFunc =>
    matchList
      [AnfFunc]
      [Bool]
      fns
      false
      (
        \h : AnfFunc =>
          \t : List AnfFunc =>
            match h [Bool] {
              | MkAnfFunc name params body => or (exprUsesReadWrite body) (funcsUseReadWrite t)
            }
      )

poly rec exprUsesBoxed =
  \e : AnfExpr =>
    match e [Bool] {
      | AE_Var n => false
      | AE_Native t => false
      | AE_Lam n b => exprUsesBoxed b
      | AE_Call f args => listAnyUsesBoxed args
      | AE_Con tag total arity args => true
      | AE_Case scrut arms => true
      | AE_Let name val body => or (exprUsesBoxed val) (exprUsesBoxed body)
    }

poly rec listAnyUsesBoxed =
  \es : List AnfExpr =>
    matchList
      [AnfExpr]
      [Bool]
      es
      false
      (
        \h : AnfExpr =>
          \t : List AnfExpr => or (exprUsesBoxed h) (listAnyUsesBoxed t)
      )

poly rec funcsUseBoxedObjects =
  \fns : List AnfFunc =>
    matchList
      [AnfFunc]
      [Bool]
      fns
      false
      (
        \h : AnfFunc =>
          \t : List AnfFunc =>
            match h [Bool] {
              | MkAnfFunc name params body => or (exprUsesBoxed body) (funcsUseBoxedObjects t)
            }
      )

poly funcsUseBoxed =
  \fns : List AnfFunc =>
    or
      (funcsUseBoxedObjects fns)
      (
        match (collectClosedNames (prepareCallFuncs (buildGlobalIndex (Empty [List (List U8)]) fns) fns)) [Bool] {
          | nil => false
          | cons h t => true
        }
      )

poly compileSourceToLlvmText =
  \source : List U8 =>
    match (tokenize source) [List U8] {
      | Err e => "ERR:Lex error"
      | Ok toks =>
        match (parseProgram toks) [List U8] {
          | Err e => "ERR:Parse error"
          | Ok decls =>
            match (elaborateProgramToCore decls) [List U8] {
              | Err e => append [U8] "ERR:" e
              | Ok coreDefs =>
                match (buildMiniProgram coreDefs "main") [List U8] {
                  | Err e => append [U8] "ERR:" e
                  | Ok prog =>
                    let normalized = normalizeProgram prog in
                    match (emitProgram normalized) [List U8] {
                      | Err e => append [U8] "ERR:" e
                      | Ok llvm =>
                        match normalized [List U8] {
                          | MkAnfProgram funcs entry =>
                            let boxedLlvm = if [List U8] (funcsUseBoxed funcs) (\u : U8 => append [U8] "declare ptr @trip_alloc_obj(i64, i64)\ndeclare void @trip_obj_set_field(ptr, i64, i64)\ndeclare i64 @trip_obj_tag(ptr)\ndeclare i64 @trip_obj_field(ptr, i64)\n\n" llvm) (\u : U8 => llvm) in
                            if [List U8] (funcsUseReadWrite funcs)
                              (
                                \u : U8 =>
                                  append
                                    [U8]
                                    "declare void @trip_write_one(i8)\ndeclare i8 @trip_read_one()\n\n"
                                    boxedLlvm
                              )
                              (\u : U8 => boxedLlvm)
                        }
                    }
                }
            }
        }
    }
